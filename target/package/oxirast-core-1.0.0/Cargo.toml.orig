[package]
name = "oxirast-core"
description = "A fast, fine-grained WebAssembly frontend framework for Rust."
license = "MIT"
repository = "https://github.com/Michaelmk708/oxirast-rust_web_framework"
version = "1.0.0"
edition = "2021"
authors = ["Michael Kinuthia <michaelkinuthia708@gmail.com>"]
readme = "../README.md" 
keywords = ["wasm", "frontend", "webassembly", "framework", "reactivity"]
categories = ["wasm", "web-programming"]

[dependencies]
wasm-bindgen = "0.2"
wasm-bindgen-futures = "0.4"
serde = { version = "1.0", features = ["derive"] }
reqwest = { version = "0.11", features = ["json"] }

[dependencies.web-sys]
version = "0.3"
features = [
    "Document",
    "Element",
    "HtmlElement",
    "HtmlInputElement",
    "Node",
    "NodeList",
    "Window",
    "Event",
    "EventTarget",
    "Text",
    "History",  
    "Location", 
    "console",  
]